---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MerchArt from '../components/MerchArt.astro';
import { formatPrice, type MerchArtName } from '../data/site';

type Category = 'Handbags' | 'Vessels' | 'Aircraft' | 'Jewellery' | 'Motoring' | 'Property' | 'Cellar' | 'Interiors';

interface Listing {
  lot: string;
  art: MerchArtName;
  category: Category;
  title: string;
  description: string;
  original: number;
  asking: number;
  condition: string;
  reason: string;
  seller: string;
}

const listings: Listing[] = [
  {
    lot: '01',
    art: 'bag',
    category: 'Handbags',
    title: 'Crocodile Top-Handle Bag, Ochre',
    description:
      'Hand-stitched over eleven hundred hours by a craftsman who has since retired, citing this bag. Carried once, to a funeral that turned out to be a christening.',
    original: 410000,
    asking: 465000,
    condition: 'Emotionally unworn',
    reason: 'It saw me cry. It has to go.',
    seller: 'A Member, Gstaad',
  },
  {
    lot: '02',
    art: 'yacht',
    category: 'Vessels',
    title: 'Motor Yacht, 88 Metres',
    description:
      'Six decks, a helipad, a cinema and a smaller yacht in the garage, in case this one is unavailable. Sleeps twenty-four guests and, in a separate corridor, the crew.',
    original: 240000000,
    asking: 310000000,
    condition: 'Has been to Sardinia. Will not discuss it.',
    reason: 'The seller is upgrading to a yacht that can carry this yacht.',
    seller: 'A Member since 2009, Monaco',
  },
  {
    lot: '03',
    art: 'jet',
    category: 'Aircraft',
    title: 'Long-Range Business Jet',
    description:
      'Fourteen seats, two bedrooms and a shower that works at forty-one thousand feet. The interior still smells, faintly, of a decision the seller regrets.',
    original: 72000000,
    asking: 79500000,
    condition: 'Lightly flown, mostly over poor countries, at altitude',
    reason: 'A friend bought the same one. We are no longer friends.',
    seller: 'A Member, Palm Beach',
  },
  {
    lot: '04',
    art: 'necklace',
    category: 'Jewellery',
    title: 'Pearl Rivière with Yellow Diamond',
    description:
      'Forty-two South Sea pearls, matched over six years, around a pear-cut yellow diamond of nineteen carats. Worn to one gala, where another woman was wearing it too.',
    original: 3200000,
    asking: 3950000,
    condition: 'Flawless. The other woman has been dealt with.',
    reason: 'It is now associated with her.',
    seller: 'A Member, Saint-Tropez',
  },
  {
    lot: '05',
    art: 'ring',
    category: 'Jewellery',
    title: 'Engagement Ring, Eleven Carats',
    description:
      'An emerald-cut diamond on a platinum band, previously engaged, briefly. The ring outlasted the marriage, which speaks to its quality.',
    original: 1800000,
    asking: 2400000,
    condition: 'Never removed during the marriage, which was eight weeks',
    reason: 'The seller is engaged again and the new ring is larger. It had to be.',
    seller: 'A Member, Mayfair',
  },
  {
    lot: '06',
    art: 'watch',
    category: 'Jewellery',
    title: 'Grand Complication, Rose Gold',
    description:
      'Perpetual calendar, minute repeater and moon phase, in case one needs to know the moon. One of six made. The other five owners have been informed of the sale and are upset.',
    original: 1100000,
    asking: 1100000,
    condition: 'Keeps perfect time, which the seller found oppressive',
    reason: 'The seller no longer acknowledges time.',
    seller: 'A Member since 2014, Geneva',
  },
  {
    lot: '07',
    art: 'car',
    category: 'Motoring',
    title: 'Coupé, 1962, Rosso Corsa',
    description:
      'One of thirty-six built, with matching numbers and a complete history. Driven twelve kilometres since restoration, all of them in reverse, by the valet.',
    original: 14000000,
    asking: 16500000,
    condition: 'Concours. The valet has been let go.',
    reason: 'The garage is needed for a horse.',
    seller: 'A Member, Lake Como',
  },
  {
    lot: '08',
    art: 'champagne',
    category: 'Cellar',
    title: 'Champagne, 1907, Recovered from a Shipwreck',
    description:
      'Eleven bottles brought up from the Baltic seabed after a century at ideal temperature. Originally twelve. The seller opened one to check.',
    original: 880000,
    asking: 950000,
    condition: 'Sealed, except the one',
    reason: 'It tasted like a shipwreck.',
    seller: 'A Member, Belgravia',
  },
  {
    lot: '09',
    art: 'island',
    category: 'Property',
    title: 'Private Island, Forty Acres',
    description:
      'A white-sand island with a main house, six guest villas and a reef the seller has never looked at. Comes with one resident caretaker, who has asked not to be included.',
    original: 58000000,
    asking: 64000000,
    condition: 'Unspoilt, apart from the caretaker',
    reason: 'Too far from the other islands.',
    seller: 'A Member, location withheld',
  },
  {
    lot: '10',
    art: 'chandelier',
    category: 'Interiors',
    title: 'Crystal Chandelier, Formerly of a Ballroom',
    description:
      'Two thousand hand-cut crystals and forty-eight candles, from a ballroom the seller bought in order to remove this chandelier. The ballroom is also available, without a chandelier.',
    original: 2600000,
    asking: 3100000,
    condition: 'Complete. Dusted weekly by a man in white gloves, who is not included.',
    reason: 'The ceilings in the new house are only nine metres.',
    seller: 'A Member since 2018, Paris',
  },
];

const categories = ['All', ...new Set(listings.map((l) => l.category))];

// The hero collage. Spans are set per tile; the layout collapses to two columns on small screens.
const collage: { art: MerchArtName; tag: string; tone: string; span: string }[] = [
  { art: 'yacht', tag: 'Motor yacht, 88 m', tone: 'cream', span: 'wide tall' },
  { art: 'bag', tag: 'Crocodile, ochre', tone: 'amber', span: '' },
  { art: 'ring', tag: 'Eleven carats', tone: 'ink', span: '' },
  { art: 'jet', tag: 'Long-range jet', tone: 'ivory', span: 'wide' },
  { art: 'necklace', tag: 'Pearl rivière', tone: 'sand', span: 'tall' },
  { art: 'watch', tag: 'One of six', tone: 'cream', span: '' },
  { art: 'car', tag: 'Coupé, 1962', tone: 'amber', span: 'wide' },
  { art: 'champagne', tag: 'Cellar, 1907', tone: 'ink', span: '' },
  { art: 'island', tag: 'Forty acres', tone: 'ivory', span: '' },
];

const markup = (l: Listing) => Math.round(((l.asking - l.original) / l.original) * 100);

const steps = [
  {
    n: '01',
    title: 'Disenchantment',
    body: 'You notice that something you own no longer reflects who you are. Usually because someone less important owns one too.',
  },
  {
    n: '02',
    title: 'Collection',
    body: 'We remove the item discreetly, typically while you are abroad, so that you never have to watch it leave or carry anything.',
  },
  {
    n: '03',
    title: 'Appraisal',
    body: 'Our specialists establish what you paid, then add a provenance premium for the fact that you owned it. It has never once gone down.',
  },
  {
    n: '04',
    title: 'Placement',
    body: 'The item is offered privately to members of equal or superior standing. Never to anyone who would describe it as “a bargain”.',
  },
];
---

<Base
  title="Merch"
  description="Pre-owned luxury from the private collections of our members. Previously owned, never previously affordable."
>
  <section class="merch-hero">
    <div class="container merch-hero__grid">
      <div class="merch-hero__copy stack" style="--stack:28px">
        <p class="eyebrow" data-reveal>Merch · Members’ Resale</p>
        <h1 class="h1" data-reveal style="--d:.08s">Previously owned. <em>Never</em> previously affordable.</h1>
        <p class="lede" data-reveal style="--d:.16s">
          Our members occasionally tire of things. A yacht, a necklace, a small island. Rather than let these pieces
          fall into the open market, where anyone could buy them, we place them quietly with members who deserve them.
          Prices reflect what was paid, plus what it meant to have been owned by someone like them.
        </p>
        <div class="merch-hero__cta" data-reveal style="--d:.24s">
          <a href="#catalogue" class="btn">Browse the catalogue <Icon name="arrow" /></a>
          <a href="#consign" class="btn btn--ghost">Consign an item</a>
        </div>
      </div>

      <div class="collage" role="img" aria-label="A collage of a yacht, a crocodile handbag, a diamond ring, a private jet, a pearl necklace, a gold watch, a classic coupé, vintage champagne and a private island">
        {
          collage.map((t, i) => (
            <figure class:list={['collage__tile', `tone-${t.tone}`, t.span]} data-reveal style={`--d:${0.05 * i}s`}>
              <MerchArt name={t.art} class="collage__art" />
              <figcaption>{t.tag}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight pricing-note">
    <div class="container pricing-note__grid">
      <p class="statement" data-reveal>
        Nothing here is <em>discounted</em>. These pieces were expensive when they were bought, and they have only become
        more expensive since, by association.
      </p>
      <dl class="pricing-note__facts" data-reveal style="--d:.1s">
        <div>
          <dt>Average provenance premium</dt>
          <dd>+14%</dd>
        </div>
        <div>
          <dt>Items ever sold below cost</dt>
          <dd>None</dd>
        </div>
        <div>
          <dt>Items returned</dt>
          <dd>One, by a yacht</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--cream catalogue" id="catalogue">
    <div class="container">
      <header class="catalogue__head">
        <div class="stack" style="--stack:20px">
          <p class="eyebrow" data-reveal>The current catalogue</p>
          <h2 class="h2" data-reveal style="--d:.06s">Ten pieces, <em>briefly</em> available.</h2>
        </div>
        <div class="filters" role="group" aria-label="Filter by category" data-reveal style="--d:.12s">
          {
            categories.map((c, i) => (
              <button type="button" class:list={['filter', { 'is-active': i === 0 }]} data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>
                {c}
              </button>
            ))
          }
        </div>
      </header>

      <ol class="listings">
        {
          listings.map((l) => (
            <li class="listing" data-category={l.category} data-reveal>
              <div class="listing__art">
                <MerchArt name={l.art} />
                <span class="listing__lot">Lot {l.lot}</span>
                <span class="listing__cat">{l.category}</span>
              </div>
              <div class="listing__body">
                <h3 class="listing__title">{l.title}</h3>
                <p class="listing__desc">{l.description}</p>
                <dl class="listing__meta">
                  <div>
                    <dt>Condition</dt>
                    <dd>{l.condition}</dd>
                  </div>
                  <div>
                    <dt>Reason for sale</dt>
                    <dd>{l.reason}</dd>
                  </div>
                </dl>
                <div class="listing__prices">
                  <div>
                    <span class="listing__label">Originally</span>
                    <s class="listing__was">{formatPrice(l.original)}</s>
                  </div>
                  <div>
                    <span class="listing__label">Now</span>
                    <strong class="listing__now">{formatPrice(l.asking)}</strong>
                  </div>
                  <span class="listing__premium">
                    {markup(l) > 0 ? `+${markup(l)}% provenance` : 'Held at cost, as a kindness'}
                  </span>
                </div>
                <div class="listing__foot">
                  <span class="listing__seller">{l.seller}</span>
                  <button
                    type="button"
                    class="btn btn--sm"
                    data-concierge={`tried to make an offer on the ${l.title} (asking ${formatPrice(l.asking)}) in the members’ resale catalogue`}
                  >
                    Make an offer
                  </button>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark process" id="consign">
    <div class="container">
      <div class="process__head">
        <p class="eyebrow" data-reveal>Consignment</p>
        <h2 class="h2" data-reveal style="--d:.08s">How a member lets go. <em>Gracefully.</em></h2>
      </div>
      <ol class="process__steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i * 0.1}s`}>
              <span class="step__n">{s.n}</span>
              <h3 class="step__title">{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="refused" data-reveal>
        <p class="refused__title">We do not accept</p>
        <ul>
          <li>Anything bought in a sale</li>
          <li>Anything with a receipt under $10,000</li>
          <li>Gifts from staff, however thoughtful</li>
          <li>Former spouses, whatever you were told at dinner</li>
        </ul>
      </div>
      <div class="process__cta" data-reveal>
        <a href="/apply/" class="btn btn--light">Request an invitation <Icon name="arrow" /></a>
        <a href="/membership/" class="btn btn--ghost-light">View membership</a>
      </div>
      <p class="fine merch-fine" data-reveal>
        Purchases are available to members only. Viewing is permitted, for now, and is being monitored.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .merch-hero {
    padding-top: calc(var(--header-h) + clamp(24px, 4vw, 56px));
    padding-bottom: clamp(56px, 8vw, 112px);
    border-bottom: 1px solid var(--border);
  }
  .merch-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .merch-hero__copy .h1 {
    font-size: clamp(40px, 4.8vw, 72px);
  }
  .merch-hero__copy .lede {
    max-width: 30em;
  }
  .merch-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(112px, 14.5vh, 160px);
    grid-auto-flow: dense;
    gap: clamp(10px, 1.2vw, 16px);
  }
  .collage__tile {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 14px 14px 34px;
    box-shadow: var(--shadow-sm);
  }
  .collage__tile.wide {
    grid-column: span 2;
  }
  .collage__tile.tall {
    grid-row: span 2;
  }
  .collage__tile :global(.collage__art) {
    max-width: 100%;
    max-height: 100%;
    transition: transform 1.2s var(--ease);
  }
  .collage__tile:hover :global(.collage__art) {
    transform: scale(1.05) rotate(-1.5deg);
  }
  .collage__tile figcaption {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-family: var(--font-display);
    opacity: 0.75;
  }
  .tone-cream {
    background: var(--stone-100);
  }
  .tone-ivory {
    background: var(--stone-0);
  }
  .tone-sand {
    background: var(--stone-200);
  }
  .tone-amber {
    background: var(--amber-200);
  }
  .tone-ink {
    background: var(--stone-900);
    color: var(--stone-50);
  }
  .tone-ink :global(.merch-art) {
    color: var(--stone-50);
  }
  .tone-ink :global(.fill-ink) {
    fill: var(--stone-50);
  }
  .tone-amber :global(.fill-accent) {
    fill: var(--amber-600);
  }

  /* ---------- Pricing note ---------- */
  .pricing-note__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .pricing-note__facts {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--border);
  }
  .pricing-note__facts div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
  }
  .pricing-note__facts dt {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .pricing-note__facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--accent-text);
  }

  /* ---------- Catalogue ---------- */
  .catalogue__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 640px;
  }
  .filter {
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    font: 600 12px/1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .filter:hover {
    border-color: var(--accent);
  }
  .filter.is-active {
    background: var(--stone-900);
    border-color: var(--stone-900);
    color: var(--stone-50);
  }

  .listings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 2.4vw, 32px);
  }
  .listing {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      box-shadow 0.6s var(--ease),
      transform 0.6s var(--ease);
  }
  .listing:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .listing[hidden] {
    display: none;
  }
  .listing__art {
    position: relative;
    display: grid;
    place-items: center;
    padding: 40px 24px;
    background: var(--stone-100);
    border-right: 1px solid var(--border);
  }
  .listing:nth-child(4n + 2) .listing__art,
  .listing:nth-child(4n + 3) .listing__art {
    background: var(--amber-100);
  }
  .listing__art :global(.merch-art) {
    max-width: 200px;
    transition: transform 1s var(--ease);
  }
  .listing:hover .listing__art :global(.merch-art) {
    transform: scale(1.06);
  }
  .listing__lot,
  .listing__cat {
    position: absolute;
    top: 16px;
    font: 700 var(--text-2xs) / 1 var(--font-display);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .listing__lot {
    left: 16px;
    color: var(--accent-text);
  }
  .listing__cat {
    right: 16px;
    color: var(--text-secondary);
  }
  .listing__body {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2.4vw, 32px);
  }
  .listing__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: var(--tracking-heading);
  }
  .listing__desc {
    margin: 12px 0 18px;
    font-size: 14.5px;
    color: var(--text-secondary);
  }
  .listing__meta {
    margin: 0 0 20px;
    display: grid;
    gap: 10px;
    font-size: 13.5px;
  }
  .listing__meta dt {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .listing__meta dd {
    margin: 2px 0 0;
    font-style: italic;
  }
  .listing__prices {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 8px 24px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .listing__label {
    display: block;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .listing__was {
    font-size: 14px;
    color: var(--text-secondary);
  }
  .listing__now {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .listing__premium {
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-wash);
    color: var(--accent-text);
    font: 700 11px/1.2 var(--font-display);
    letter-spacing: 0.04em;
  }
  .listing__foot {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .listing__seller {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* ---------- Consignment ---------- */
  .process__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .process__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .step {
    padding-top: 28px;
    border-top: 1px solid var(--border-inverse);
  }
  .step__n {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    color: var(--accent-soft);
  }
  .step__title {
    margin: 20px 0 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.1;
  }
  .step p {
    margin: 0;
    color: var(--stone-400);
    font-size: 15px;
  }
  .refused {
    margin-top: clamp(56px, 7vw, 88px);
    padding: 28px 32px;
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px 48px;
    align-items: start;
  }
  .refused__title {
    margin: 0;
    font: 700 var(--text-xs) / 1.6 var(--font-display);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .refused ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 32px;
    color: var(--stone-300);
    font-size: 15px;
  }
  .refused li::before {
    content: '—';
    margin-right: 10px;
    color: var(--accent-soft);
  }
