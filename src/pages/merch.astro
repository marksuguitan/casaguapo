  @media (max-width: 960px) {
    .merch-hero__grid {
      grid-template-columns: 1fr;
    }
    .collage {
      grid-auto-rows: clamp(120px, 22vw, 180px);
    }
  }
  @media (max-width: 860px) {
    .pricing-note__grid {
      grid-template-columns: 1fr;
    }
