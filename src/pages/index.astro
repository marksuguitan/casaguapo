---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { images, technologyServices, lifestyleServices, tiers, formatPrice } from '../data/site';

// Fictional publications, all of them owned by members.
const press = [
  { quote: 'Unbearable. We have renewed for life.', masthead: 'The Gilded Gazette' },
  { quote: 'Finally, somewhere the help can’t afford to read about.', masthead: 'Trust Fund Times' },
  { quote: 'I didn’t know email could be this expensive. I wept.', masthead: 'Heir & Now' },
  { quote: 'Five stars. We were not permitted to give six.', masthead: 'Yacht Quarterly' },
  { quote: 'The poor will never understand it, and that is the point.', masthead: 'The Offshore Review' },
  { quote: 'Our editor applied. Our editor is no longer our editor.', masthead: 'Monaco Morning' },
];

const stats = [
  { value: '11', label: 'Members admitted in 2025' },
  { value: '4,112', label: 'Applications declined, without regret' },
  { value: '0', label: 'Members who have ever seen a price tag' },
  { value: '3', label: 'Former members we no longer discuss' },
];

const principles = [
  {
    icon: 'lock',
    title: 'Discretion',
    body: 'We believe privacy is a fundamental right. Membership, however, is a privilege. Our clients’ names are known only to us, their families, their former families, and in most cases the international press.',
  },
  {
    icon: 'diamond',
    title: 'Standards',
    body: 'Each prospective member is assessed on aesthetic, financial and entirely arbitrary grounds. We have never lowered our standards. We have raised them mid-interview, and once mid-sentence, when the applicant said “budget”.',
  },
  {
    icon: 'key',
    title: 'Infrastructure',
    body: 'Because ordinary infrastructure is for ordinary people, and we have met ordinary people. Every system we operate is private, dedicated and maintained by engineers chosen, in part, for how they look in a server room.',
  },
];
const overheard = [
  {
    quote: 'Someone told me there are people who have never been to Monaco. I said, “What, ever?” They said yes. I had to lie down.',
    who: 'A Member since 2014, Monaco',
  },
  {
    quote: 'I asked my driver what he does at weekends. He said “laundry”. I had no idea you could do that yourself. Very brave.',
    who: 'A Member, Ultra-Super tier',
  },
  {
    quote: 'I went into a supermarket once, for charity. Nobody carried anything for me. I left the grapes where they were. I hope someone poor found them.',
    who: 'A Member, Gstaad',
  },
  {
    quote: 'My children say I’m emotionally unavailable. My assistant says I’m “booked through spring”. I prefer my assistant.',
    who: 'A Member since 2018, Mayfair',
  },
  {
    quote: 'I asked whether my staff were happy. They said that wasn’t a service they offer. I respect that enormously.',
    who: 'A Member, Lake Como',
  },
  {
    quote: 'I looked at the $10,000 membership once, the way you look at a car accident.',
    who: 'A Member, Ultra-Super tier',
  },
];
---

<Base overlayHeader>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img src={images.heroVilla} alt="" loading="eager" fetchpriority="high" data-photo />
    </div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="container hero__content on-dark">
      <p class="eyebrow hero__eyebrow">Private Technology &amp; Lifestyle Concierge. Probably not for you.</p>
      <h1 class="display hero__title">
        <span class="hero__line"><span>Beautiful people deserve</span></span>
        <span class="hero__line"><span>beautiful servers.</span></span>
        <span class="hero__line"><span>Everyone else has <em>Gmail</em>.</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__lede">
          Private email, private databases and privately sourced friends, for people who have never once had to
          check a price. Membership begins at $10,000 a month, which we’re told is a lot.
        </p>
        <div class="hero__actions">
          <a href="/apply/" class="btn btn--light">Apply anyway <Icon name="arrow" /></a>
          <a href="/services/" class="btn btn--ghost-light">See what you can’t afford</a>
        </div>
      </div>
    </div>

    <div class="hero__meta container">
      <span>Geneva · Monaco · A yacht we’d rather not name</span>
      <span>Currently admitting 0.27% of applicants. Not you.</span>
    </div>
  </section>

  <!-- Clientele strip -->
  <section class="press" aria-label="Press">
    <p class="press__label container">As reviewed by publications our members happen to own</p>
    <div class="press__marquee">
      {
        [0, 1].map((copy) => (
          <ul class="press__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {press.map((p) => (
              <li class="press__item">
                <span class="press__quote">“{p.quote}”</span>
                <span class="press__masthead">{p.masthead}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <!-- Introduction -->
  <section class="section intro" id="house">
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="eyebrow" data-reveal>The House</p>
        <h2 class="h2" data-reveal style="--d:.08s">
          Because ordinary infrastructure is for <em>ordinary people.</em>
        </h2>
        <div class="intro__text" data-reveal style="--d:.16s">
          <p class="lede">
            Casaguapo was founded in 2009, when our founder discovered that she was using the same email provider as her
            gardener. She has not recovered. Neither, we understand, has the gardener.
          </p>
          <p class="lede">
            Today we manage the private technology, daily logistics and continued radiance of a membership we describe,
            accurately, as the finest in existence, and, less publicly, as the only people we can stand.
          </p>
        </div>
        <a href="/services/" class="link-arrow" data-reveal style="--d:.24s">Discover the services <Icon name="arrow" /></a>
      </div>
      <figure class="portrait" data-reveal style="--d:.12s">
        <div class="portrait__frame">
          <div class="portrait__canvas">
            <svg class="portrait__sitter" viewBox="0 0 300 380" aria-hidden="true">
              <!-- A member in silhouette, in the manner of an eighteenth-century cameo. -->
              <path d="M122 258C78 246 62 170 88 120C108 80 158 60 196 78C216 90 224 112 222 134L238 162Q242 168 232 171L226 173Q234 179 227 185Q233 191 223 197Q221 213 201 215Q186 217 184 233L188 262C240 272 282 302 292 380L8 380C18 312 66 276 122 262Z" />
              <circle cx="86" cy="98" r="30" />
              <path d="M128 286Q160 312 196 284" fill="none" stroke="var(--amber-50)" stroke-width="7" stroke-dasharray="0.1 13" stroke-linecap="round" />
            </svg>
          </div>
        </div>
        <figcaption class="portrait__placard">
          <span class="portrait__title">Portrait of a Member Upon Learning What Rent Is</span>
          <span class="portrait__meta">Oil on inherited canvas, 2019. She did not recover. Her estate remains a valued client.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--cream pillars">
    <div class="container">
      <div class="pillars__head">
        <p class="eyebrow" data-reveal>Two disciplines</p>
        <h2 class="h2" data-reveal style="--d:.08s">One extraordinarily <em>narrow</em> clientele.</h2>
      </div>

      <div class="pillars__grid">
        <article class="pillar" data-reveal>
          <Photo src={images.serverRoom} alt="A private server hall" class="pillar__photo" reveal={false} />
          <div class="pillar__body">
            <p class="pillar__index">I.</p>
            <h3 class="h3">Private Technology</h3>
            <p>Your data deserves the same exclusivity as your social circle. Ideally, more.</p>
            <ul class="pillar__list">
              {
                technologyServices.map((s) => (
                  <li>
                    <Icon name={s.icon} size={20} />
                    <a href={`/services/#${s.slug}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>

        <article class="pillar" data-reveal style="--d:.12s">
          <Photo src={images.restaurant} alt="An intimate private dining room" class="pillar__photo" reveal={false} />
          <div class="pillar__body">
            <p class="pillar__index">II.</p>
            <h3 class="h3">Beauty &amp; Lifestyle</h3>
            <p>For those who refuse to accept perfection as a stopping point, or ageing as a concept.</p>
            <ul class="pillar__list">
              {
                lifestyleServices.map((s) => (
                  <li>
                    <Icon name={s.icon} size={20} />
                    <a href={`/services/#${s.slug}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section--tight stats" aria-label="The House in figures">
    <div class="container stats__grid">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section section--dark testimonial">
    <div class="container testimonial__grid">
      <Photo src={images.portraitManTwo} alt="Portrait of a member, name withheld" class="testimonial__photo" />
      <figure class="testimonial__quote">
        <p class="eyebrow">In confidence</p>
        <blockquote data-reveal>
          “My previous email provider allowed <em>anyone</em> to write to me. Including, once, a man named Gary. Casaguapo has corrected this, and Gary.”
        </blockquote>
        <figcaption data-reveal style="--d:.12s">
          <span>A Member since 2019</span>
          <span class="fine">Surname withheld. First name also withheld.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Principles -->
  <section class="section principles">
    <div class="container">
      <div class="principles__head">
        <p class="eyebrow" data-reveal>Our principles</p>
        <p class="statement" data-reveal style="--d:.08s">
          Beauty is subjective. Fortunately, our admission standards <em>aren’t.</em>
        </p>
      </div>
      <div class="principles__grid">
        {
          principles.map((p, i) => (
            <article class="principle" data-reveal style={`--d:${i * 0.1}s`}>
              <span class="principle__icon">
                <Icon name={p.icon} size={26} />
              </span>
              <h3 class="h3">{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Overheard -->
  <section class="section section--dark overheard">
    <div class="container">
      <div class="overheard__head">
        <p class="eyebrow" data-reveal>Overheard in the members’ lounge</p>
        <h2 class="h2" data-reveal style="--d:.08s">Our members, in their own <em>words.</em></h2>
        <p class="fine" data-reveal style="--d:.12s">Reproduced with permission. Names withheld at the request of their lawyers, and in one case his mother, who still thinks he works in shipping.</p>
      </div>
      <div class="overheard__grid">
        {
          overheard.map((o, i) => (
            <figure class="quote-card" data-reveal style={`--d:${(i % 3) * 0.08}s`}>
              <blockquote>“{o.quote}”</blockquote>
              <figcaption>{o.who}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Membership teaser -->
  <section class="section section--cream teaser">
    <div class="container">
      <div class="teaser__head">
        <div>
          <p class="eyebrow" data-reveal>Membership</p>
          <h2 class="h2" data-reveal style="--d:.08s">Three tiers. <em>No exceptions.</em></h2>
        </div>
        <a href="/membership/" class="link-arrow" data-reveal>Compare memberships <Icon name="arrow" /></a>
      </div>
      <div class="teaser__grid">
        {
          tiers.map((t, i) => (
            <a href="/membership/" data-concierge={`opened the ${t.name} membership (${formatPrice(t.price)} a month) from the homepage`} class:list={['teaser-card', { 'is-featured': t.featured }]} data-reveal style={`--d:${i * 0.1}s`}>
              <span class="teaser-card__name">{t.name}</span>
              <span class="teaser-card__price">
                {formatPrice(t.price)}
                <small>/ month</small>
              </span>
              <span class="teaser-card__pos">{t.positioning}</span>
              <span class="teaser-card__more">
                Details <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="closing">
    <Photo src={images.hotel} alt="A private estate at twilight" class="closing__photo" reveal={false} />
    <div class="closing__veil" aria-hidden="true"></div>
    <div class="container closing__content on-dark">
      <p class="eyebrow" data-reveal>Admissions</p>
      <h2 class="h1" data-reveal style="--d:.08s">
        Your friends should be as carefully selected as your <em>investments.</em>
      </h2>
      <p class="closing__text" data-reveal style="--d:.16s">So, regrettably, should our members. You may still apply. We could all use the laugh.</p>
      <div data-reveal style="--d:.24s">
        <a href="/apply/" class="btn btn--light">Apply, for the experience <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--surface);
    background: var(--stone-950);
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 60% at 70% 30%, rgba(var(--amber-rgb), 0.28), transparent 70%),
      linear-gradient(170deg, var(--stone-700) 0%, var(--stone-950) 75%);
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    animation: hero-zoom 2.8s var(--ease) forwards;
    transition: opacity 0.8s;
  }
  .hero__media img.is-missing {
    opacity: 0;
  }
  @keyframes hero-zoom {
    to {
      transform: scale(1);
    }
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(var(--ink-rgb), 0.55) 0%, rgba(var(--ink-rgb), 0.1) 30%, rgba(var(--ink-rgb), 0.25) 55%, rgba(var(--ink-rgb), 0.82) 100%);
  }
  .hero__content {
    position: relative;
    padding-top: calc(var(--header-h) + 80px);
    padding-bottom: 56px;
  }
  .hero__eyebrow {
    margin: 0 0 28px;
    opacity: 0;
    animation: fade-up 1.2s var(--ease) 0.3s forwards;
  }
  .hero__title {
    font-size: clamp(44px, 7vw, 104px);
    max-width: 12.5em;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__line > span {
    display: inline-block;
    transform: translateY(105%);
    animation: line-up 1.4s var(--ease) forwards;
  }
  .hero__line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .hero__line:nth-child(3) > span {
    animation-delay: 0.24s;
  }
  .hero__title em {
    color: var(--accent-soft);
  }
  .hero__foot {
    margin-top: clamp(40px, 6vw, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 32px clamp(32px, 6vw, 96px);
    opacity: 0;
    animation: fade-up 1.4s var(--ease) 0.6s forwards;
  }
  .hero__lede {
    margin: 0;
    max-width: 30em;
    color: rgba(249, 246, 239, 0.8);
    font-size: clamp(15px, 1.2vw, 17px);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    border-top: 1px solid var(--border-inverse);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: rgba(249, 246, 239, 0.6);
  }
  @keyframes line-up {
    to {
      transform: none;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Clientele */
  .press {
    padding-block: 34px 38px;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .press__label {
    margin: 0 auto 24px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .press__marquee {
    display: flex;
    width: max-content;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .press__track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: press-scroll 60s linear infinite;
  }
  .press:hover .press__track {
    animation-play-state: paused;
  }
  @keyframes press-scroll {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .press__track {
      animation: none;
    }
  }
  .press__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 340px;
    padding: 0 40px;
    border-left: 1px solid var(--border);
  }
  .press__quote {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--stone-800);
  }
  .press__masthead {
    font-family: var(--font-logo);
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* Intro */
  .intro__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(48px, 8vw, 128px);
    align-items: center;
  }
  .intro__copy {
    display: grid;
    gap: 32px;
    justify-items: start;
  }
  .intro__copy .h2 {
    max-width: 10em;
  }
  .intro__text {
    display: grid;
    gap: 18px;
  }
  .portrait {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 28px;
  }
  .portrait__frame {
    width: min(100%, 440px);
    padding: 22px;
    border-radius: 50%;
    background:
      linear-gradient(145deg, var(--amber-300), var(--amber-700) 38%, var(--amber-400) 62%, var(--amber-800));
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.25),
      inset 0 0 0 9px rgba(var(--ink-rgb), 0.18),
      var(--shadow-lg);
  }
  .portrait__canvas {
    aspect-ratio: 4 / 5;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: end center;
    background: radial-gradient(120% 90% at 40% 25%, var(--amber-50), var(--amber-200) 55%, var(--amber-400));
    box-shadow: inset 0 0 40px rgba(var(--ink-rgb), 0.25);
  }
  .portrait__sitter {
    width: 78%;
    margin-bottom: -2px;
    color: var(--stone-900);
    fill: var(--stone-900);
  }
  .portrait__placard {
    display: grid;
    gap: 8px;
    max-width: 22em;
    padding: 16px 22px;
    text-align: center;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-sm);
  }
  .portrait__title {
    font-family: var(--font-logo);
    font-size: 17px;
    line-height: 1.3;
    color: var(--text);
  }
  .portrait__meta {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Pillars */
  .pillars__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
  }
  .pillar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .pillar:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .pillar__photo {
    border-radius: 0;
    aspect-ratio: 16 / 10;
  }
  .pillar:hover .pillar__photo :global(img) {
    transform: scale(1.04);
  }
  .pillar__body {
    padding: clamp(28px, 3.4vw, 48px);
  }
  .pillar__index {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    color: var(--accent-text);
  }
  .pillar__body > p:not(.pillar__index) {
    margin: 12px 0 28px;
    color: var(--text-secondary);
  }
  .pillar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .pillar__list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
    color: var(--accent-text);
  }
  .pillar__list a {
    flex: 1;
    color: var(--stone-900);
    font-size: 15px;
    font-weight: 500;
    transition: padding 0.5s var(--ease);
  }
  .pillar__list a:hover {
    padding-left: 6px;
  }

  /* Stats */
  .stats {
    border-bottom: 1px solid var(--border);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    display: grid;
    gap: 10px;
    padding: 8px clamp(16px, 2.4vw, 36px);
    border-left: 1px solid var(--border);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 5.4vw, 80px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    font-size: 13px;
    color: var(--text-secondary);
    max-width: 14em;
  }

  /* Testimonial */
  .testimonial__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(48px, 8vw, 128px);
    align-items: center;
  }
  .testimonial__photo {
    aspect-ratio: 4 / 5;
  }
  .testimonial__quote {
    margin: 0;
  }
  .testimonial__quote blockquote {
    margin: 32px 0 40px;
    font-family: var(--font-display);
    font-weight: 500;
