---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { images, technologyServices, lifestyleServices, tiers, formatPrice } from '../data/site';

const clientele = [
  'Three reigning monarchies',
  'Two of the four most photographed jawlines in Monaco',
  'A gentleman who owns the concept of brunch',
  'Several heirs, one of them to a colour',
  'The person you are thinking of',
];

const stats = [
  { value: '11', label: 'Members admitted in 2025' },
  { value: '4,112', label: 'Applications declined, with regret' },
  { value: '0', label: 'Servers shared with anyone' },
  { value: '24/7', label: 'Admiration, on request' },
];

const principles = [
  {
    icon: 'lock',
    title: 'Discretion',
    body: 'We believe privacy is a fundamental right. Membership, however, is a privilege. Our clients’ names are known only to us, their families, and in most cases the international press.',
  },
  {
    icon: 'diamond',
    title: 'Standards',
    body: 'Each prospective member is assessed on aesthetic, financial and entirely arbitrary grounds. We have never lowered our standards. We have, on occasion, raised them mid-interview.',
  },
  {
    icon: 'key',
    title: 'Infrastructure',
    body: 'Because ordinary infrastructure is for ordinary people. Every system we operate is private, dedicated and maintained by engineers chosen, in part, for how they look in a server room.',
  },
];
---

<Base overlayHeader>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img src={images.heroVilla} alt="" loading="eager" fetchpriority="high" data-photo />
    </div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="container hero__content on-dark">
      <p class="eyebrow hero__eyebrow">Private Technology &amp; Lifestyle Concierge</p>
      <h1 class="display hero__title">
        <span class="hero__line"><span>Exceptional technology.</span></span>
        <span class="hero__line"><span>For exceptionally</span></span>
        <span class="hero__line"><span><em>attractive</em> people.</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__lede">
          Casaguapo provides private digital infrastructure, personal management and aesthetic stewardship to a very
          small number of very remarkable individuals. By invitation only.
        </p>
        <div class="hero__actions">
          <a href="/apply/" class="btn btn--light">Request an invitation <Icon name="arrow" /></a>
          <a href="/services/" class="btn btn--ghost-light">The services</a>
        </div>
      </div>
    </div>

    <div class="hero__meta container">
      <span>Geneva · Monaco · Mayfair</span>
      <span>Currently admitting 0.27% of applicants</span>
    </div>
  </section>

  <!-- Clientele strip -->
  <section class="clientele" aria-label="Clientele">
    <div class="container clientele__inner">
      <p class="clientele__label">Entrusted by clients we are not permitted to name</p>
      <ul class="clientele__list">
        {clientele.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Introduction -->
  <section class="section intro" id="house">
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="eyebrow" data-reveal>The House</p>
        <h2 class="h2" data-reveal style="--d:.08s">
          Because ordinary infrastructure is for <em>ordinary people.</em>
        </h2>
        <div class="intro__text" data-reveal style="--d:.16s">
          <p class="lede">
            Founded on the observation that the most beautiful people in the world were using the same email providers
            as everyone else, Casaguapo was established to correct an imbalance few were brave enough to name.
          </p>
          <p class="lede">
            Today we manage the private technology, daily logistics and continued radiance of a membership we describe,
            accurately, as the finest in existence.
          </p>
        </div>
        <a href="/services/" class="link-arrow" data-reveal style="--d:.24s">Discover the services <Icon name="arrow" /></a>
      </div>
      <div class="intro__media">
        <Photo src={images.interior} alt="A serene, light-filled private residence" class="intro__photo-a" />
        <Photo src={images.portraitWomanTwo} alt="Portrait of a member, name withheld" class="intro__photo-b media--warm" />
        <p class="intro__caption fine">A member, photographed at rest. Name withheld for reasons of beauty.</p>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--cream pillars">
    <div class="container">
      <div class="pillars__head">
        <p class="eyebrow" data-reveal>Two disciplines</p>
        <h2 class="h2" data-reveal style="--d:.08s">One extraordinarily <em>narrow</em> clientele.</h2>
      </div>

      <div class="pillars__grid">
        <article class="pillar" data-reveal>
          <Photo src={images.serverRoom} alt="A private server hall" class="pillar__photo" reveal={false} />
          <div class="pillar__body">
            <p class="pillar__index">I.</p>
            <h3 class="h3">Private Technology</h3>
            <p>Your data deserves the same exclusivity as your social circle.</p>
            <ul class="pillar__list">
              {
                technologyServices.map((s) => (
                  <li>
                    <Icon name={s.icon} size={20} />
                    <a href={`/services/#${s.slug}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>

        <article class="pillar" data-reveal style="--d:.12s">
          <Photo src={images.restaurant} alt="An intimate private dining room" class="pillar__photo" reveal={false} />
          <div class="pillar__body">
            <p class="pillar__index">II.</p>
            <h3 class="h3">Beauty &amp; Lifestyle</h3>
            <p>For those who refuse to accept perfection as a stopping point.</p>
            <ul class="pillar__list">
              {
                lifestyleServices.map((s) => (
                  <li>
                    <Icon name={s.icon} size={20} />
                    <a href={`/services/#${s.slug}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section--tight stats" aria-label="The House in figures">
    <div class="container stats__grid">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section section--dark testimonial">
    <div class="container testimonial__grid">
      <Photo src={images.portraitManTwo} alt="Portrait of a member, name withheld" class="testimonial__photo" />
      <figure class="testimonial__quote">
        <p class="eyebrow">In confidence</p>
        <blockquote data-reveal>
          “My previous email provider allowed <em>anyone</em> to write to me. Casaguapo has corrected this.”
        </blockquote>
        <figcaption data-reveal style="--d:.12s">
          <span>A Member since 2019</span>
          <span class="fine">Surname withheld. First name also withheld.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Principles -->
  <section class="section principles">
    <div class="container">
      <div class="principles__head">
        <p class="eyebrow" data-reveal>Our principles</p>
        <p class="statement" data-reveal style="--d:.08s">
          Beauty is subjective. Fortunately, our admission standards <em>aren’t.</em>
        </p>
      </div>
      <div class="principles__grid">
        {
          principles.map((p, i) => (
            <article class="principle" data-reveal style={`--d:${i * 0.1}s`}>
              <span class="principle__icon">
                <Icon name={p.icon} size={26} />
              </span>
              <h3 class="h3">{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Membership teaser -->
  <section class="section section--cream teaser">
    <div class="container">
      <div class="teaser__head">
        <div>
          <p class="eyebrow" data-reveal>Membership</p>
          <h2 class="h2" data-reveal style="--d:.08s">Three tiers. <em>No exceptions.</em></h2>
        </div>
        <a href="/membership/" class="link-arrow" data-reveal>Compare memberships <Icon name="arrow" /></a>
      </div>
      <div class="teaser__grid">
        {
          tiers.map((t, i) => (
            <a href="/membership/" data-concierge={`opened the ${t.name} membership (${formatPrice(t.price)} a month) from the homepage`} class:list={['teaser-card', { 'is-featured': t.featured }]} data-reveal style={`--d:${i * 0.1}s`}>
              <span class="teaser-card__name">{t.name}</span>
              <span class="teaser-card__price">
                {formatPrice(t.price)}
                <small>/ month</small>
              </span>
              <span class="teaser-card__pos">{t.positioning}</span>
              <span class="teaser-card__more">
                Details <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="closing">
    <Photo src={images.hotel} alt="A private estate at twilight" class="closing__photo" reveal={false} />
    <div class="closing__veil" aria-hidden="true"></div>
    <div class="container closing__content on-dark">
      <p class="eyebrow" data-reveal>Admissions</p>
      <h2 class="h1" data-reveal style="--d:.08s">
        Your friends should be as carefully selected as your <em>investments.</em>
      </h2>
      <p class="closing__text" data-reveal style="--d:.16s">So, regrettably, should our members.</p>
      <div data-reveal style="--d:.24s">
        <a href="/apply/" class="btn btn--light">Begin your application <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--surface);
    background: var(--stone-950);
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 60% at 70% 30%, rgba(var(--amber-rgb), 0.28), transparent 70%),
      linear-gradient(170deg, var(--stone-700) 0%, var(--stone-950) 75%);
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    animation: hero-zoom 2.8s var(--ease) forwards;
    transition: opacity 0.8s;
  }
  .hero__media img.is-missing {
    opacity: 0;
  }
  @keyframes hero-zoom {
    to {
      transform: scale(1);
    }
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(var(--ink-rgb), 0.55) 0%, rgba(var(--ink-rgb), 0.1) 30%, rgba(var(--ink-rgb), 0.25) 55%, rgba(var(--ink-rgb), 0.82) 100%);
  }
  .hero__content {
    position: relative;
    padding-top: calc(var(--header-h) + 80px);
    padding-bottom: 56px;
  }
  .hero__eyebrow {
    margin: 0 0 28px;
    opacity: 0;
    animation: fade-up 1.2s var(--ease) 0.3s forwards;
  }
  .hero__title {
    max-width: 11.5em;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__line > span {
    display: inline-block;
    transform: translateY(105%);
    animation: line-up 1.4s var(--ease) forwards;
  }
  .hero__line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .hero__line:nth-child(3) > span {
    animation-delay: 0.24s;
  }
  .hero__title em {
    color: var(--accent-soft);
  }
  .hero__foot {
    margin-top: clamp(40px, 6vw, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 32px clamp(32px, 6vw, 96px);
    opacity: 0;
    animation: fade-up 1.4s var(--ease) 0.6s forwards;
  }
  .hero__lede {
    margin: 0;
    max-width: 30em;
    color: rgba(249, 246, 239, 0.8);
    font-size: clamp(15px, 1.2vw, 17px);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    border-top: 1px solid var(--border-inverse);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: rgba(249, 246, 239, 0.6);
  }
  @keyframes line-up {
    to {
      transform: none;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Clientele */
  .clientele {
    border-bottom: 1px solid var(--border);
  }
  .clientele__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 48px;
    padding-block: 30px;
  }
  .clientele__label {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: var(--text-secondary);
    max-width: 16em;
  }
  .clientele__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    color: var(--stone-700);
  }

  /* Intro */
  .intro__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(48px, 8vw, 128px);
    align-items: center;
  }
  .intro__copy {
    display: grid;
    gap: 32px;
    justify-items: start;
  }
  .intro__copy .h2 {
    max-width: 10em;
  }
  .intro__text {
    display: grid;
    gap: 18px;
  }
  .intro__media {
    position: relative;
    padding-bottom: 18%;
  }
  .intro__photo-a {
    aspect-ratio: 4 / 5;
    width: 78%;
    margin-left: auto;
    box-shadow: var(--shadow);
  }
  .intro__photo-b {
    position: absolute !important;
    left: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 3 / 4;
    border: 8px solid var(--surface);
    border-radius: 22px;
    box-shadow: var(--shadow-lg);
  }
  .intro__caption {
    position: absolute;
    left: 48%;
    bottom: 0;
    margin: 0;
    max-width: 18em;
  }

  /* Pillars */
  .pillars__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
  }
  .pillar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .pillar:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .pillar__photo {
    border-radius: 0;
    aspect-ratio: 16 / 10;
  }
  .pillar:hover .pillar__photo :global(img) {
    transform: scale(1.04);
  }
  .pillar__body {
    padding: clamp(28px, 3.4vw, 48px);
  }
  .pillar__index {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    color: var(--accent-text);
  }
  .pillar__body > p:not(.pillar__index) {
    margin: 12px 0 28px;
    color: var(--text-secondary);
  }
  .pillar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .pillar__list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
    color: var(--accent-text);
  }
  .pillar__list a {
    flex: 1;
    color: var(--stone-900);
    font-size: 15px;
    font-weight: 500;
    transition: padding 0.5s var(--ease);
  }
  .pillar__list a:hover {
    padding-left: 6px;
  }

  /* Stats */
  .stats {
    border-bottom: 1px solid var(--border);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    display: grid;
    gap: 10px;
    padding: 8px clamp(16px, 2.4vw, 36px);
    border-left: 1px solid var(--border);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 5.4vw, 80px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    font-size: 13px;
    color: var(--text-secondary);
    max-width: 14em;
  }

  /* Testimonial */
  .testimonial__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(48px, 8vw, 128px);
    align-items: center;
  }
  .testimonial__photo {
    aspect-ratio: 4 / 5;
  }
  .testimonial__quote {
    margin: 0;
  }
  .testimonial__quote blockquote {
    margin: 32px 0 40px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .testimonial__quote blockquote em {
    font-style: normal;
    color: var(--accent-soft);
  }
  .testimonial__quote figcaption {
    display: grid;
    gap: 4px;
    padding-top: 24px;
    border-top: 1px solid var(--border-inverse);
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .testimonial__quote .fine {
    color: var(--stone-400);
  }

  /* Principles */
  .principles__head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .principles__head .statement {
    max-width: 18em;
  }
  .principles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.4vw, 32px);
  }
  .principle {
    padding: clamp(28px, 3vw, 44px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
    transition:
      border-color 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }
  .principle:hover {
    border-color: rgba(var(--amber-rgb), 0.5);
    box-shadow: var(--shadow);
  }
  .principle__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 40px;
    border-radius: 999px;
    border: 1px solid rgba(var(--amber-rgb), 0.45);
    color: var(--accent-text);
  }
  .principle p {
    margin: 14px 0 0;
    color: var(--text-secondary);
    font-size: 15px;
  }

  /* Teaser */
  .teaser__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .teaser__head > div {
    display: grid;
    gap: 20px;
  }
  .teaser__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .teaser-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 300px;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      transform 0.7s var(--ease),
      box-shadow 0.7s var(--ease);
  }
  .teaser-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .teaser-card.is-featured {
    background: var(--stone-900);
    color: var(--surface);
    border-color: var(--stone-900);
  }
  .teaser-card__name {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: var(--accent-text);
  }
  .is-featured .teaser-card__name {
    color: var(--accent-soft);
  }
  .teaser-card__price {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(44px, 4vw, 60px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .teaser-card__price small {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-left: 6px;
  }
  .is-featured .teaser-card__price small,
  .is-featured .teaser-card__pos {
    color: var(--stone-400);
  }
  .teaser-card__pos {
    color: var(--text-secondary);
    font-size: 14.5px;
  }
  .teaser-card__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: var(--font-display);
  }

  /* Closing */
  .closing {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .closing__photo {
    position: absolute !important;
    inset: 0;
    border-radius: 0;
  }
  .closing__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(var(--ink-rgb), 0.86) 0%, rgba(var(--ink-rgb), 0.55) 55%, rgba(var(--ink-rgb), 0.25) 100%);
  }
  .closing__content {
    position: relative;
    color: var(--surface);
    display: grid;
    gap: 28px;
    justify-items: start;
    padding-block: 120px;
  }
  .closing__content .h1 {
    max-width: 12em;
  }
  .closing__text {
    margin: 0;
    font-size: 18px;
    color: rgba(249, 246, 239, 0.75);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .clientele__inner {
      grid-template-columns: 1fr;
      gap: 16px;
    }
