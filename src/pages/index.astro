---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { images, technologyServices, lifestyleServices, tiers, formatPrice } from '../data/site';

// Fictional publications, all of them owned by members.
const press = [
  { quote: 'Unbearable. We have renewed for life.', masthead: 'The Gilded Gazette' },
  { quote: 'Finally, somewhere the help can’t afford to read about.', masthead: 'Trust Fund Times' },
  { quote: 'I didn’t know email could be this expensive. I wept.', masthead: 'Heir & Now' },
  { quote: 'Five stars. We were not permitted to give six.', masthead: 'Yacht Quarterly' },
  { quote: 'The poor will never understand it, and that is the point.', masthead: 'The Offshore Review' },
  { quote: 'Our editor applied. Our editor is no longer our editor.', masthead: 'Monaco Morning' },
];

const stats = [
  { value: '11', label: 'Members admitted in 2025' },
  { value: '4,112', label: 'Applications declined, without regret' },
  { value: '0', label: 'Members who have ever seen a price tag' },
  { value: '3', label: 'Former members we no longer discuss' },
];

const principles = [
  {
    icon: 'lock',
    title: 'Discretion',
    body: 'We believe privacy is a fundamental right. Membership, however, is a privilege. Our clients’ names are known only to us, their families, their former families, and in most cases the international press.',
  },
  {
    icon: 'diamond',
    title: 'Standards',
    body: 'Each prospective member is assessed on aesthetic, financial and entirely arbitrary grounds. We have never lowered our standards. We have raised them mid-interview, and once mid-sentence, when the applicant said “budget”.',
  },
  {
    icon: 'key',
    title: 'Infrastructure',
    body: 'Because ordinary infrastructure is for ordinary people, and we have met ordinary people. Every system we operate is private, dedicated and maintained by engineers chosen, in part, for how they look in a server room.',
  },
];
const overheard = [
  {
    quote: 'Someone told me there are people who have never been to Monaco. I said, “What, ever?” They said yes. I had to lie down.',
    who: 'A Member since 2014, Monaco',
  },
  {
    quote: 'I asked my driver what he does at weekends. He said “laundry”. I had no idea you could do that yourself. Very brave.',
    who: 'A Member, Ultra-Super tier',
  },
  {
    quote: 'I went into a supermarket once, for charity. Nobody carried anything for me. I left the grapes where they were. I hope someone poor found them.',
    who: 'A Member, Gstaad',
  },
  {
    quote: 'My children say I’m emotionally unavailable. My assistant says I’m “booked through spring”. I prefer my assistant.',
    who: 'A Member since 2018, Mayfair',
  },
  {
    quote: 'I asked whether my staff were happy. They said that wasn’t a service they offer. I respect that enormously.',
    who: 'A Member, Lake Como',
  },
  {
    quote: 'I looked at the $10,000 membership once, the way you look at a car accident.',
    who: 'A Member, Ultra-Super tier',
  },
];
---

<Base overlayHeader>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img src={images.heroVilla} alt="" loading="eager" fetchpriority="high" data-photo />
    </div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="container hero__content on-dark">
      <p class="eyebrow hero__eyebrow">Private Technology &amp; Lifestyle Concierge. Probably not for you.</p>
      <h1 class="display hero__title">
        <span class="hero__line"><span>Beautiful people deserve</span></span>
        <span class="hero__line"><span>beautiful servers.</span></span>
        <span class="hero__line"><span>Everyone else has <em>Gmail</em>.</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__lede">
          We host your inbox on hardware with its own sommelier, back up your data to a server room with a doorman, and
          change your passwords before you suffer the indignity of forgetting them.
        </p>
        <div class="hero__actions">
          <a href="/apply/" class="btn btn--light">Apply anyway <Icon name="arrow" /></a>
          <a href="/services/" class="btn btn--ghost-light">See what you can’t afford</a>
        </div>
      </div>
    </div>

    <div class="hero__meta container">
      <span>Geneva · Monaco · A yacht we’d rather not name</span>
      <span>Currently admitting 0.27% of applicants. Not you.</span>
    </div>
  </section>

  <!-- Clientele strip -->
  <section class="press" aria-label="Press">
    <p class="press__label container">As reviewed by publications our members happen to own</p>
    <div class="press__marquee">
      {
        [0, 1].map((copy) => (
          <ul class="press__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {press.map((p) => (
              <li class="press__item">
                <span class="press__quote">“{p.quote}”</span>
                <span class="press__masthead">{p.masthead}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <!-- Introduction -->
  <section class="section intro" id="house">
    <div class="container intro__grid">
      <div class="intro__copy">
        <h2 class="h2" data-reveal>
          Because ordinary infrastructure is for <em>ordinary people.</em>
        </h2>
        <div class="intro__text" data-reveal style="--d:.16s">
          <p class="lede">
            Casaguapo began in 2009, the night our founder discovered that she was using the same email provider as her
            maid. She has not recovered. Neither, we understand, has the maid.
          </p>
          <p class="lede">
            Today we manage the private technology, daily logistics and continued radiance of a membership we describe,
            accurately, as the finest in existence, and, less publicly, as the only people we can stand.
          </p>
        </div>
        <a href="/services/" class="link-arrow" data-reveal style="--d:.24s">Discover the services <Icon name="arrow" /></a>
      </div>
      <figure class="artifact" data-reveal style="--d:.12s">
        <div class="artifact__frame">
          <div class="artifact__canvas">
            <svg class="artifact__scene" viewBox="0 0 300 380" aria-hidden="true">
              <!-- The founding server, displayed like a museum piece. -->
              <defs>
                <linearGradient id="beam" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#fff8e8" stop-opacity=".34" />
                  <stop offset="1" stop-color="#fff8e8" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="gilt" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fcc652" />
                  <stop offset=".45" stop-color="#9a6400" />
                  <stop offset=".7" stop-color="#f4b024" />
                  <stop offset="1" stop-color="#744b04" />
                </linearGradient>
                <linearGradient id="marble" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fffdf8" />
                  <stop offset="1" stop-color="#e6ddcd" />
                </linearGradient>
              </defs>
              <path class="artifact__beam" d="M128 0H172L262 318H38Z" fill="url(#beam)" />
              <ellipse cx="150" cy="318" rx="104" ry="10" fill="#000" opacity=".35" />
              <g class="artifact__crown" fill="url(#gilt)">
                <path d="M126 92L132 74L141 84L150 68L159 84L168 74L174 92Z" />
                <rect x="126" y="92" width="48" height="5" rx="1.5" />
              </g>
              <rect x="98" y="100" width="104" height="204" rx="5" fill="#262420" stroke="url(#gilt)" stroke-width="3" />
              {
                Array.from({ length: 8 }, (_, i) => (
                  <g transform={`translate(108 ${112 + i * 23.5})`}>
                    <rect width="84" height="17" rx="2" fill="#171512" stroke="#3d3934" />
                    <path d="M8 8.5H52" stroke="#3d3934" stroke-width="3" stroke-linecap="round" />
                    <circle class="artifact__led" cx="66" cy="8.5" r="2.2" style={`--i:${i}`} />
                    <circle class="artifact__led artifact__led--slow" cx="75" cy="8.5" r="2.2" style={`--i:${(i * 5) % 8}`} />
                  </g>
                ))
              }
              <rect x="70" y="304" width="160" height="14" rx="2" fill="url(#marble)" />
              <rect x="80" y="318" width="140" height="62" fill="url(#marble)" />
              <path d="M96 332C130 340 150 326 190 350M120 380C140 362 168 368 206 356" stroke="#d2c7b4" fill="none" />
              <g fill="url(#gilt)">
                <rect x="30" y="268" width="7" height="112" rx="3" />
                <circle cx="33.5" cy="266" r="8" />
                <rect x="263" y="268" width="7" height="112" rx="3" />
                <circle cx="266.5" cy="266" r="8" />
              </g>
              <path d="M38 276C90 330 210 330 262 276" stroke="#6e1d28" stroke-width="7" fill="none" stroke-linecap="round" />
              <path d="M38 274C90 326 210 326 262 274" stroke="#a03a48" stroke-width="2" fill="none" opacity=".6" />
            </svg>
          </div>
        </div>
        <figcaption class="portrait__placard">
          <span class="portrait__title">The Founding Server</span>
          <span class="portrait__meta">Steel and gold leaf, 2009. It hosts one inbox, and has never once been asked to share.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- History -->
  <section class="section history" aria-labelledby="history-title">
    <div class="container">
      <div class="history__head">
        <p class="eyebrow" data-reveal>Since 2009</p>
        <h2 class="h2" id="history-title" data-reveal style="--d:.08s">A brief history of <em>standards.</em></h2>
      </div>
      <div class="timeline" data-timeline>
        <div class="timeline__track" aria-hidden="true"><span class="timeline__fill" data-timeline-fill></span></div>
        <ol class="timeline__list">
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2009</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 14h28a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V16a2 2 0 0 1 2-2Z" pathLength="1" style="--k:0" /><path d="M8 16l16 12 16-12" pathLength="1" style="--k:1" /><path d="M24 3v5M15 5l2.5 4M33 5l-2.5 4" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">The Incident</h3>
            </div>
            <p>It began at a charity gala, when our founder learned that she and her maid used the same email provider. The same one, as if the two of them were on the same level. She left before dessert, furious, and spent the drive home staring at the back of her chauffeur’s head, wondering what else she had in common with her subordinates.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2009</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M20 6a12 12 0 1 1 0 24a12 12 0 1 1 0-24Z" pathLength="1" style="--k:0" /><path d="M29 29l12 12" pathLength="1" style="--k:1" /><path d="M14 16h12M14 21h12M14 26h6" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">The inventory</h3>
            </div>
            <p>By morning her staff had compiled the list, and it was long. She breathed the same air as them. She shared their alphabet, their blood type and, in one unforgivable case, a birthday. Discovering how much she had in common with lower-class humans devastated her. She took to her bed for a week, on sheets nobody else had ever slept on.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2009</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M12 5h24v38H12Z" pathLength="1" style="--k:0" /><path d="M17 12h10M17 20h10M17 28h10M17 36h10" pathLength="1" style="--k:1" /><path d="M31 12h.01M31 20h.01M31 28h.01M31 36h.01" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">The east wing</h3>
            </div>
            <p>When she rose, she had a plan. A private server was installed in the east wing of Casa Guapo, her forty-room estate on Lake Como, in the room that had held her late husband’s wine collection. The wine went to the maid as a parting gift. The maid had not known she was parting.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2010</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M6 19a26 26 0 0 1 36 0" pathLength="1" style="--k:0" /><path d="M12 26a17 17 0 0 1 24 0" pathLength="1" style="--k:1" /><path d="M18 33a8 8 0 0 1 12 0" pathLength="1" style="--k:2" /><path d="M24 40h.01" pathLength="1" style="--k:3" /></svg>
              <h3 class="tl-item__title">Separate everything</h3>
            </div>
            <p>The server was only the beginning. The remaining staff were given their own Wi-Fi, their own entrance and, eventually, their own weather app, set to a slightly worse forecast. For the first time in a year our founder felt like herself again: never happier, and entirely alone, which she has always considered the same thing.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2011</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M17 8a6 6 0 1 1 0 12a6 6 0 1 1 0-12ZM31 8a6 6 0 1 1 0 12a6 6 0 1 1 0-12Z" pathLength="1" style="--k:0" /><path d="M6 40c0-7 5-12 11-12s11 5 11 12" pathLength="1" style="--k:1" /><path d="M20 40c0-7 5-12 11-12s11 5 11 12" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">The lunch</h3>
            </div>
            <p>Over lunch she told her friends, all four of them, about the maid. One by one they checked their phones, and one by one they went pale. Every one of them had been emailing on the same servers as their drivers. A duchess wept into her consommé. A shipping heir had to lie down on the terrace. Nobody touched the soufflé.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2011</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 34l3-18 9 9 4-13 4 13 9-9 3 18Z" pathLength="1" style="--k:0" /><path d="M8 40h32" pathLength="1" style="--k:1" /><path d="M24 30h.01" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">The pact</h3>
            </div>
            <p>That afternoon the five of them made a pact: it would never again happen to anyone who mattered. Casaguapo, named after the house, opened that spring. The first members paid in advance, in cash and, in one case, in a small island.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2013</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M16 8c-5 0-8 4-8 9 0 6 3 9 4 14s2 11 5 11 3-8 7-8 4 8 7 8 4-6 5-11 4-8 4-14c0-5-3-9-8-9-3 0-5 2-8 2s-5-2-8-2Z" pathLength="1" style="--k:0" /><path d="M18 14c2 1 4 1.5 6 1.5" pathLength="1" style="--k:1" /></svg>
              <h3 class="tl-item__title">The dentist</h3>
            </div>
            <p>Two years in, one of our most prominent members discovered that their emails were sharing server space with their dentist’s. A dentist, they explained, may violate one’s mouth. He may not violate the place where one’s emails, photographs and inner life are kept. We bought the data centre that night and closed it. The dentist was “relocated”, a word we chose carefully and have never been asked to explain.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2013</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 12c0-3 6-5 14-5s14 2 14 5-6 5-14 5-14-2-14-5Z" pathLength="1" style="--k:0" /><path d="M10 12v24c0 3 6 5 14 5s14-2 14-5V12" pathLength="1" style="--k:1" /><path d="M10 24c0 3 6 5 14 5s14-2 14-5" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">Never again</h3>
            </div>
            <p>From then on, no member would share server space with anyone. Each was given their own servers, in their own building, behind their own gate, guarded by people who had been told nothing and paid accordingly.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2016</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M22 4c6 0 10 5 10 11s-4 11-10 11-10-5-10-11 4-11 10-11Z" pathLength="1" style="--k:0" /><path d="M22 26v4M19 30h6l-1 13h-4Z" pathLength="1" style="--k:1" /><path d="M37 26l1.5 3.5L42 31l-3.5 1.5L37 36l-1.5-3.5L32 31l3.5-1.5Z" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">The mirror</h3>
            </div>
            <p>With their data finally safe, the members had time to look at themselves properly for the first time in years, and did not care for the resolution. The beauty division opened that afternoon. Mirrors that disagreed were replaced. So were two husbands.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2019</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 36a8 8 0 0 1-1-16 11 11 0 0 1 21-2 8 8 0 0 1 1 18Z" pathLength="1" style="--k:0" /><path d="M7 7l34 34" pathLength="1" style="--k:1" /></svg>
              <h3 class="tl-item__title">The cloud</h3>
            </div>
            <p>When the world moved to the cloud, an engineer explained that it was simply other people’s computers. Our founder thanked him for his honesty and had him escorted from every property she owns, which took most of a weekend.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">2023</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 34a14 14 0 0 1 28 0Z" pathLength="1" style="--k:0" /><path d="M6 39h36" pathLength="1" style="--k:1" /><path d="M24 20v-5M20.5 14h7" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">Jasmin</h3>
            </div>
            <p>Our human staff kept being kind to applicants, as though they were all on the same level. So we hired Jasmin. On her first day she declined 340 of them, a minor royal and our founder’s own mother, on a technicality we stand by.</p>
          </div>
        </li>
        <li class="tl-item" data-tl-item>
          <span class="tl-item__dot" aria-hidden="true"></span>
          <p class="tl-item__date">Today</p>
          <div class="tl-item__card">
            <div class="tl-item__head">
              <svg class="tl-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 10a3 3 0 1 1 0 6a3 3 0 1 1 0-6ZM38 10a3 3 0 1 1 0 6a3 3 0 1 1 0-6Z" pathLength="1" style="--k:0" /><path d="M10 16v26M38 16v26M6 42h8M34 42h8" pathLength="1" style="--k:1" /><path d="M10 20c6 11 22 11 28 0" pathLength="1" style="--k:2" /></svg>
              <h3 class="tl-item__title">Full circle</h3>
            </div>
            <p>And the maid? She applied last month, from a free email address. Jasmin declined her in under a second. Our founder calls it the happiest moment of her life, which tells you everything you need to know about her life.</p>
          </div>
        </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--cream pillars">
    <div class="container">
      <div class="pillars__head">
        <p class="eyebrow" data-reveal>Two disciplines</p>
        <h2 class="h2" data-reveal style="--d:.08s">One extraordinarily <em>narrow</em> clientele.</h2>
      </div>

      <div class="pillars__grid">
        <article class="pillar" data-reveal>
          <Photo src={images.serverRoom} alt="A private server hall" class="pillar__photo" reveal={false} />
          <div class="pillar__body">
            <p class="pillar__index">I.</p>
            <h3 class="h3">Private Technology</h3>
            <p>Your data deserves the same exclusivity as your social circle. Ideally, more.</p>
            <ul class="pillar__list">
              {
                technologyServices.map((s) => (
                  <li>
                    <Icon name={s.icon} size={20} />
                    <a href={`/services/#${s.slug}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>

        <article class="pillar" data-reveal style="--d:.12s">
          <Photo src={images.restaurant} alt="An intimate private dining room" class="pillar__photo" reveal={false} />
          <div class="pillar__body">
            <p class="pillar__index">II.</p>
            <h3 class="h3">Beauty &amp; Lifestyle</h3>
            <p>For those who refuse to accept perfection as a stopping point, or ageing as a concept.</p>
            <ul class="pillar__list">
              {
                lifestyleServices.map((s) => (
                  <li>
                    <Icon name={s.icon} size={20} />
                    <a href={`/services/#${s.slug}`}>{s.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section--tight stats" aria-label="The House in figures">
    <div class="container stats__grid">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section section--dark testimonial">
    <div class="container testimonial__grid">
      <Photo src={images.portraitManTwo} alt="Portrait of a member, name withheld" class="testimonial__photo" />
      <figure class="testimonial__quote">
        <p class="eyebrow">In confidence</p>
        <blockquote data-reveal>
          “My previous email provider allowed <em>anyone</em> to write to me. Including, once, a man named Gary. Casaguapo has corrected this, and Gary.”
        </blockquote>
        <figcaption data-reveal style="--d:.12s">
          <span>A Member since 2019</span>
          <span class="fine">Surname withheld. First name also withheld.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Principles -->
  <section class="section principles">
    <div class="container">
