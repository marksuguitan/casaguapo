<script>
  // History timeline: the line draws down as you scroll, and each entry lights up as the line reaches it.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline) {
    const fill = timeline.querySelector<HTMLElement>('[data-timeline-fill]')!;
    const items = [...timeline.querySelectorAll<HTMLElement>('[data-tl-item]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let queued = false;
    const update = () => {
      queued = false;
      const box = timeline.getBoundingClientRect();
      const tip = innerHeight * 0.62;
      const p = still ? 1 : Math.min(1, Math.max(0, (tip - box.top) / box.height));
      fill.style.setProperty('--tl-p', p.toFixed(4));
      const reach = box.top + p * box.height;
      for (const item of items) {
        const dot = item.querySelector<HTMLElement>('.tl-item__dot')!.getBoundingClientRect();
        if (dot.top + dot.height / 2 <= reach + 1) item.classList.add('is-on');
      }
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>

