---

<svg
  class:list={['merch-art', className]}
  viewBox={viewBoxes[name] ?? '0 0 200 200'}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={art[name]}
/>

<style>
  .merch-art {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--stone-900);
  }
  .merch-art :global(.fill-accent) {
    fill: var(--amber-500);
  }
  .merch-art :global(.fill-gold) {
    fill: var(--amber-300);
  }
  .merch-art :global(.fill-deep) {
    fill: var(--amber-800);
  }
  .merch-art :global(.fill-ivory) {
    fill: var(--stone-25);
  }
  .merch-art :global(.fill-ink) {
    fill: var(--stone-900);
  }
  .merch-art :global(.stroke-accent) {
    stroke: var(--amber-500);
  }
</style>
