---
import Icon from './Icon.astro';
---

<div class="concierge" data-concierge-root>
  <div class="concierge__remark" data-remark hidden role="status" aria-live="polite">
    <div class="concierge__remark-head">
      <img class="concierge__avatar" src="/images/concierge.webp" alt="" width="36" height="36" />
      <span class="concierge__label">Jasmin</span>
      <button type="button" class="concierge__dismiss" data-remark-close aria-label="Dismiss">
        <Icon name="close" size={14} />
      </button>
    </div>
    <p class="concierge__remark-text" data-remark-text></p>
  </div>

  <section class="concierge__panel" data-panel hidden aria-label="Talk to Jasmin">
    <header class="concierge__panel-head">
      <img class="concierge__avatar" src="/images/concierge.webp" alt="" width="36" height="36" />
      <div>
        <p class="concierge__title">Jasmin</p>
        <p class="concierge__subtitle">Concierge · Not here to help you</p>
      </div>
      <button type="button" class="concierge__dismiss" data-panel-close aria-label="Close">
        <Icon name="close" size={16} />
      </button>
    </header>
    <div class="concierge__log" data-log aria-live="polite"></div>
    <form class="concierge__form" data-chat-form>
      <label class="visually-hidden" for="concierge-input">Your message</label>
      <input
        id="concierge-input"
        name="message"
        autocomplete="off"
        maxlength="600"
        placeholder="Make it quick, sweetie…"
        data-chat-input
      />
      <button type="submit" class="concierge__send" aria-label="Send">
        <Icon name="arrow" size={18} />
      </button>
    </form>
  </section>

  <button type="button" class="concierge__launcher" data-launcher aria-expanded="false" aria-label="Talk to Jasmin">
    <span class="concierge__launcher-avatar">
      <img src="/images/concierge.webp" alt="" width="34" height="34" />
      <span class="concierge__dot" aria-hidden="true"></span>
    </span>
    Jasmin
  </button>
</div>

<style>
  .concierge {
    position: fixed;
    right: clamp(16px, 2.4vw, 32px);
    bottom: clamp(16px, 2.4vw, 32px);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    font-family: var(--font-body);
    pointer-events: none;
  }
  .concierge > * {
    pointer-events: auto;
  }

  .concierge__launcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 22px 0 9px;
    border-radius: 999px;
    border: 1px solid rgba(var(--amber-rgb), 0.4);
    background: var(--stone-900);
    color: var(--surface);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: var(--font-display);
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  @media (max-width: 640px) {
    .concierge__launcher {
      padding: 0 9px;
      font-size: 0;
      gap: 0;
    }
  }
  .concierge__launcher:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .concierge__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent-soft);
    box-shadow: 0 0 0 0 rgba(var(--amber-rgb), 0.6);
    animation: concierge-pulse 2.6s var(--ease) infinite;
  }
  @keyframes concierge-pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(var(--amber-rgb), 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(var(--amber-rgb), 0);
    }
  }

  .concierge__avatar {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    object-fit: cover;
    background: #f3d35b;
    box-shadow: 0 0 0 1px rgba(var(--amber-rgb), 0.6);
  }
  .concierge__launcher-avatar {
    position: relative;
    display: block;
    width: 34px;
    height: 34px;
  }
  .concierge__launcher-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    object-fit: cover;
    background: #f3d35b;
  }
  .concierge__launcher-avatar .concierge__dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    border: 2px solid var(--stone-900);
    box-sizing: content-box;
  }
  .concierge__label,
  .concierge__title {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: var(--accent-text);
  }
  .concierge__dismiss {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.3s;
  }
  .concierge__dismiss:hover {
    background: var(--surface-sunken);
  }

  .concierge__remark {
    width: min(360px, calc(100vw - 32px));
    padding: 16px 18px 20px;
    border-radius: var(--radius);
    background: rgba(249, 246, 239, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    color: var(--stone-900);
    animation: concierge-in 0.7s var(--ease);
  }
  .concierge__remark[hidden],
  .concierge__panel[hidden] {
    display: none;
  }
  .concierge__remark-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .concierge__remark-text {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.35;
  }

  .concierge__panel {
    width: min(400px, calc(100vw - 32px));
    height: min(560px, calc(100svh - 120px));
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    color: var(--stone-900);
    animation: concierge-in 0.6s var(--ease);
  }
  /* Phones: the chat takes the whole visible screen, sized above the keyboard (see fitPanel). */
  @media (max-width: 640px) {
    .concierge__panel {
      position: fixed;
      left: 0;
      top: var(--vv-top, 0px);
      width: 100%;
      height: var(--vv-height, 100dvh);
      border: 0;
      border-radius: 0;
      box-shadow: none;
      z-index: 1;
      animation-name: concierge-sheet;
    }
    .concierge__panel .concierge__panel-head {
      padding-top: max(18px, env(safe-area-inset-top));
    }
    .concierge__panel .concierge__form {
      padding-bottom: max(14px, env(safe-area-inset-bottom));
    }
    .concierge:has(.concierge__panel:not([hidden])) .concierge__launcher,
    .concierge:has(.concierge__panel:not([hidden])) .concierge__remark {
      visibility: hidden;
    }
    :global(html.concierge-open),
    :global(html.concierge-open body) {
      overflow: hidden;
    }
  }
  @keyframes concierge-sheet {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .concierge__panel-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 18px 18px 22px;
    border-bottom: 1px solid var(--border);
  }
  .concierge__title {
    margin: 0;
  }
  .concierge__subtitle {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .concierge__log {
    flex: 1;
    overflow-y: auto;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .concierge__log :global(.msg) {
    max-width: 86%;
    margin: 0;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14.5px;
    line-height: 1.55;
    animation: concierge-in 0.5s var(--ease);
  }
  .concierge__log :global(.msg--assistant) {
    align-self: flex-start;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.4;
  }
  .concierge__log :global(.msg--user) {
    align-self: flex-end;
    background: var(--stone-900);
    color: var(--surface);
    border-bottom-right-radius: 4px;
  }
  .concierge__log :global(.typing),
  .concierge__remark :global(.typing) {
    display: inline-flex;
    gap: 5px;
    padding-block: 6px;
  }
  .concierge :global(.typing span) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    animation: concierge-typing 1.2s var(--ease) infinite;
  }
  .concierge :global(.typing span:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .concierge :global(.typing span:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes concierge-typing {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  .concierge__log :global(.concierge__left) {
    align-self: center;
    margin: 6px 0 0;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-secondary);
    animation: concierge-in 0.5s var(--ease);
  }
  .concierge__form input:disabled,
  .concierge__send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .concierge__form {
    display: flex;
    gap: 10px;
    padding: 14px;
    border-top: 1px solid var(--border);
    background: var(--surface-raised);
  }
  .concierge__form input {
    flex: 1;
    min-width: 0;
    height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    /* 16px or more, or iOS zooms the page when the field is focused. */
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s;
  }
  .concierge__form input:focus {
    border-color: var(--accent);
  }
  .concierge__send {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 999px;
    background: var(--stone-900);
    color: var(--surface);
    cursor: pointer;
    transition: background 0.3s;
  }
  .concierge__send:hover {
    background: var(--accent-text);
  }

  @keyframes concierge-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
</style>

<script>
  import { chat, remark, MAX_CHAT_REPLIES, type ChatTurn } from '../scripts/concierge';

  const COOLDOWN_MS = 4000;
  const MAX_REMARKS = 60;
  const PENDING_KEY = 'cg-pending-action';
  const COUNT_KEY = 'cg-remark-count';
  const HISTORY_KEY = 'cg-remarks';
  const SENT_KEY = 'cg-chat-sent';
  const LEFT_KEY = 'cg-jasmin-left';
  const LOCKOUT_MS = 24 * 60 * 60 * 1000;

  const root = document.querySelector<HTMLElement>('[data-concierge-root]')!;
  const remarkBox = root.querySelector<HTMLElement>('[data-remark]')!;
  const remarkText = root.querySelector<HTMLElement>('[data-remark-text]')!;
  const panel = root.querySelector<HTMLElement>('[data-panel]')!;
  const launcher = root.querySelector<HTMLButtonElement>('[data-launcher]')!;
  const log = root.querySelector<HTMLElement>('[data-log]')!;
  const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
  const input = root.querySelector<HTMLInputElement>('[data-chat-input]')!;

  const session = {
    get(key: string) {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set(key: string, value: string) {
      try {
        sessionStorage.setItem(key, value);
      } catch {}
    },
    take(key: string) {
      const v = this.get(key);
      try {
        sessionStorage.removeItem(key);
      } catch {}
      return v;
    },
  };

  // Survives closing the tab, so the chat limit is per visitor rather than per page.
  const local = {
    get(key: string) {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set(key: string, value: string) {
      try {
        localStorage.setItem(key, value);
      } catch {}
    },
    remove(key: string) {
      try {
        localStorage.removeItem(key);
      } catch {}
    },
  };

  // Jasmin comes back, with a fresh allowance, 24 hours after she leaves.
  if (Date.now() - Number(local.get(LEFT_KEY) ?? Infinity) > LOCKOUT_MS) {
    local.remove(LEFT_KEY);
    local.remove(SENT_KEY);
  }

  const typingDots = () => {
    const el = document.createElement('span');
    el.className = 'typing';
    el.setAttribute('aria-label', 'Jasmin is typing');
    el.innerHTML = '<span></span><span></span><span></span>';
    return el;
  };

  // ---------- Remarks on interactions ----------

  let lastRemarkAt = 0;
  let inFlight = false;
  let hideTimer: number | undefined;

  const previousRemarks = (): string[] => {
    try {
      return JSON.parse(session.get(HISTORY_KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  // The remark on screen; clicking it opens the chat with that remark as Jasmin's opening line.
  let lastRemark: string | null = null;

  async function showRemark(action: string) {
    const count = Number(session.get(COUNT_KEY) ?? 0);
    const now = Date.now();
    if (inFlight || !panel.hidden || count >= MAX_REMARKS || now - lastRemarkAt < COOLDOWN_MS) return;
    inFlight = true;
    lastRemarkAt = now;
    session.set(COUNT_KEY, String(count + 1));

    window.clearTimeout(hideTimer);
    lastRemark = null;
    remarkText.replaceChildren(typingDots());
    remarkBox.hidden = false;

    const previous = previousRemarks();
    const text = await remark(action, previous);
    session.set(HISTORY_KEY, JSON.stringify([...previous, text].slice(-5)));
    remarkText.textContent = text;
    lastRemark = text;
    inFlight = false;
    hideTimer = window.setTimeout(() => (remarkBox.hidden = true), 9000);
  }

  const clean = (s: string | null | undefined) => (s ?? '').replace(/\s+/g, ' ').trim().slice(0, 90);

  // Describes what the visitor did, in words Jasmin can react to.
  function describeClick(el: HTMLElement): string | null {
    const custom = el.closest<HTMLElement>('[data-concierge]')?.dataset.concierge;
    if (custom) return custom;
    if (el instanceof HTMLInputElement && (el.type === 'radio' || el.type === 'checkbox')) {
      const label = clean(el.closest('label')?.textContent);
      return `${el.checked ? 'ticked' : 'unticked'} “${label}” on the application form`;
    }
    const text = clean(el.getAttribute('aria-label') || el.textContent);
    if (!text) return null;
    if (el.tagName === 'SUMMARY') return `opened the question “${text}”`;
    if (el.tagName === 'A') return `clicked the link “${text}”`;
    return `pressed the button “${text}”`;
  }

  document.addEventListener(
    'click',
    (e) => {
      const target = e.target as HTMLElement;
      if (root.contains(target)) return;
      const el = target.closest<HTMLElement>(
        'a, button, summary, input[type=radio], input[type=checkbox], [data-concierge]',
      );
      if (!el) return;
      const action = describeClick(el);
      if (!action) return;

      // A link to another page unloads this one; let Jasmin comment on arrival instead.
      if (el instanceof HTMLAnchorElement && el.origin === location.origin && el.pathname !== location.pathname) {
        session.set(PENDING_KEY, action);
        return;
      }
      showRemark(action);
    },
    true,
  );

  document.addEventListener('change', (e) => {
    const el = e.target as HTMLElement;
    if (root.contains(el)) return;
    if (el instanceof HTMLSelectElement) {
      const label = clean(document.querySelector(`label[for="${el.id}"]`)?.textContent);
      showRemark(`chose “${clean(el.selectedOptions[0]?.textContent)}” for “${label}” on the application form`);
    } else if (el instanceof HTMLInputElement && el.type === 'file') {
      showRemark('uploaded a photograph of themselves for the committee to assess');
    } else if ((el instanceof HTMLInputElement && ['text', 'email'].includes(el.type)) || el instanceof HTMLTextAreaElement) {
      const label = clean(document.querySelector(`label[for="${el.id}"]`)?.textContent);
      const value = clean(el.value).slice(0, 80);
      if (value) showRemark(`typed “${value}” into the “${label}” field of the application form`);
    }
  });

  const pending = session.take(PENDING_KEY);
  if (pending) window.setTimeout(() => showRemark(`${pending}, and arrived on this page`), 1200);

  root.querySelector('[data-remark-close]')!.addEventListener('click', () => (remarkBox.hidden = true));
  remarkBox.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-remark-close]')) openPanel(false, lastRemark);
  });

  // Lets other scripts (e.g. the application form) ask for a remark.
  window.addEventListener('concierge:remark', (e) => showRemark((e as CustomEvent<string>).detail));

  // ---------- Chat ----------

  const turns: ChatTurn[] = [
    {
      role: 'assistant',
      content: 'Oh. Hi. I’m Jasmin. You’re not a member, are you? I can always tell. What do you want?',
    },
  ];

  const addMessage = (role: ChatTurn['role'], text: string) => {
    const p = document.createElement('p');
    p.className = `msg msg--${role}`;
    p.textContent = text;
    log.append(p);
    log.scrollTop = log.scrollHeight;
    return p;
  };

  // On phones the panel fills the visual viewport, which shrinks when the keyboard opens.
  const phone = window.matchMedia('(max-width: 640px)');
  function fitPanel() {
    const vv = window.visualViewport;
    if (panel.hidden || !phone.matches || !vv) return;
    panel.style.setProperty('--vv-height', `${vv.height}px`);
    panel.style.setProperty('--vv-top', `${vv.offsetTop}px`);
    log.scrollTop = log.scrollHeight;
  }
  window.visualViewport?.addEventListener('resize', fitPanel);
  window.visualViewport?.addEventListener('scroll', fitPanel);

  // `auto` is Jasmin opening the chat herself: no focus, so phones don't throw up the keyboard.
  // `opener` is something Jasmin just said, which the conversation then continues from.
  function openPanel(auto = false, opener: string | null = null) {
    remarkBox.hidden = true;
    panel.hidden = false;
    session.set(AUTO_OPEN_KEY, '1');
    document.documentElement.classList.toggle('concierge-open', phone.matches);
    fitPanel();
    launcher.setAttribute('aria-expanded', 'true');
    if (!log.childElementCount) {
      if (local.get(LEFT_KEY)) leaveChat();
      else {
        if (opener) turns[0].content = opener;
        addMessage('assistant', turns[0].content);
      }
    } else if (opener && !input.disabled && !chatting) {
      // Mid-conversation: add it as another line from Jasmin, folded into her last turn so roles still alternate.
      addMessage('assistant', opener);
      turns[turns.length - 1].content += `\n\n${opener}`;
    }
    if (!input.disabled && !auto) input.focus();
  }

  // If the visitor leaves her opener unanswered for 2 seconds, Jasmin follows up once.
  let engaged = false;
  panel.addEventListener('pointerdown', () => (engaged = true));
  input.addEventListener('focus', () => (engaged = true));
  async function nudge() {
    if (engaged || panel.hidden || chatting || input.disabled || turns.length !== 1) return;
    const pendingMsg = addMessage('assistant', '');
    pendingMsg.append(typingDots());
    const text = await remark('opened Jasmin’s chat and then ignored her for two seconds without replying', [turns[0].content]);
    if (turns.length !== 1) {
      pendingMsg.remove();
      return;
    }
    pendingMsg.textContent = text;
    turns[0].content += `\n\n${text}`;
    log.scrollTop = log.scrollHeight;
  }

  // Jasmin starts a chat 2 seconds after the visitor first scrolls, once per visit.
  const AUTO_OPEN_KEY = 'cg-chat-auto-opened';
  if (!session.get(AUTO_OPEN_KEY) && !local.get(LEFT_KEY)) {
    window.addEventListener(
      'scroll',
      () => {
        window.setTimeout(() => {
          if (!panel.hidden || session.get(AUTO_OPEN_KEY)) return;
          session.set(AUTO_OPEN_KEY, '1');
          openPanel(true, 'Oh, you’re scrolling. Sweetie, the prices don’t get lower further down. I checked. What do you want?');
          window.setTimeout(nudge, 2000);
        }, 2000);
      },
      { once: true, passive: true },
    );
  }
  function closePanel() {
    panel.hidden = true;
    document.documentElement.classList.remove('concierge-open');
    launcher.setAttribute('aria-expanded', 'false');
  }

  launcher.addEventListener('click', () => (panel.hidden ? openPanel() : closePanel()));
  root.querySelector('[data-panel-close]')!.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closePanel();
  });

  function leaveChat() {
    if (!local.get(LEFT_KEY)) local.set(LEFT_KEY, String(Date.now()));
    const notice = document.createElement('p');
    notice.className = 'concierge__left';
    notice.textContent = 'Jasmin left the chat';
    log.append(notice);
    log.scrollTop = log.scrollHeight;
    input.value = '';
    input.disabled = true;
    input.placeholder = 'Jasmin has left the chat';
    form.querySelector('button')!.disabled = true;
  }

  let chatting = false;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || chatting || input.disabled) return;
    const sent = Number(local.get(SENT_KEY) ?? 0) + 1;
    local.set(SENT_KEY, String(sent));
    chatting = true;
    input.value = '';
    addMessage('user', text);
    turns.push({ role: 'user', content: text });

    const pendingMsg = addMessage('assistant', '');
    pendingMsg.append(typingDots());
    const { reply, ended } = await chat(turns.slice(-12), sent);
    pendingMsg.textContent = reply;
    turns.push({ role: 'assistant', content: reply });
    log.scrollTop = log.scrollHeight;
    chatting = false;
    if (ended || sent >= MAX_CHAT_REPLIES) window.setTimeout(leaveChat, 1200);
  });
</script>
